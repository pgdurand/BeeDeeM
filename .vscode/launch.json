{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BeeDeeM JUnit",
      "type": "java",
      "request": "launch",
      "mainClass": "org.junit.runner.JUnitCore",
      "args": [
        "test.unit.PFTPLoaderTest"
      ],
      "cwd": "${workspaceFolder}",
      "sourcePaths": [
        "${workspaceFolder}/src"
      ],
      "console": "integratedTerminal",
      "classPaths": [
        "${workspaceFolder}/lib",
        "${workspaceFolder}/jar/*"
      ],
      "env": {
        "JAVA_TOOL_OPTIONS": "-Djava.awt.headless=true"
      }
    },
    {
      "name": "bdm-install-bank",
      "type": "java",
      "request": "launch",
      "mainClass": "bzh.plealog.dbmirror.main.BeeDeeMain",
      "vmArgs": "-Xms128M -Xmx2048M -Djava.io.tmpdir=${config:beedeem.scratchRoot}/work -DKL_LOG_TYPE=console",
      "args": [
        "install",
        "-desc",
        "${config:beedeem.descriptor}"
      ],
      "preLaunchTask": "BeeDeeM: prepare install directories",
      "cwd": "${workspaceFolder}",
      "sourcePaths": [
        "${workspaceFolder}/src"
      ],
      "console": "integratedTerminal",
      "classPaths": [
        "${workspaceFolder}/lib",
        "${workspaceFolder}/jar/*"
      ],
      "env": {
        "KL_WORKING_DIR": "${config:beedeem.scratchRoot}/work",
        "KL_mirror__path": "${config:beedeem.scratchRoot}/bank"
      }
    }
    ,
    {
      "name": "bdm-install-bank-cluster",
      "type": "java",
      "request": "launch",
      "mainClass": "bzh.plealog.dbmirror.main.BeeDeeMain",
      "vmArgs": "-Xms128M -Xmx2048M -Djava.io.tmpdir=${config:beedeem.scratchRoot}/work -DKL_LOG_TYPE=console",
      "args": [
        "install",
        "-desc",
        "${config:beedeem.descriptor}"
      ],
      "preLaunchTask": "BeeDeeM: prepare install directories",
      "cwd": "${workspaceFolder}",
      "sourcePaths": [
        "${workspaceFolder}/src"
      ],
      "console": "integratedTerminal",
      "classPaths": [
        "${workspaceFolder}/lib",
        "${workspaceFolder}/jar/*"
      ],
      "env": {
        "KL_WORKING_DIR": "${config:beedeem.scratchRoot}/work",
        "KL_mirror__path": "${config:beedeem.scratchRoot}/bank",
        "BDM_CONF_SCRIPTS": "${workspaceFolder}/conf/scripts",
        "BDM_SCHEDULER": "slurm",
        "BDM_PLATFORM": "ifremer",
        "BDM_QSTAT_CMD": "sacct",
        "BDM_QSUB_CMD": "sbatch"
      }
    }
  ]
}
